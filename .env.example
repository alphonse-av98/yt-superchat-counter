# サーバー設定
PORT=3000
HOST=127.0.0.1

# 開発モード設定（true にすると管理画面にテスト用ダミー発生パネルを表示）
ENABLE_TEST_MODE=true

# チャットイベントの詳細デバッグログ出力（未知のギフト形式調査用）
DEBUG_CHAT_EVENTS=false

# データ保存先ディレクトリ（デフォルト: ./data）
DATA_DIR=./data

# 為替レートの起動時自動取得（APIキー不要: open.er-api.com / 予備: jsDelivr currency-api）
# オフライン環境や取得失敗時は内蔵の概算レートへ自動フォールバックします
AUTO_FETCH_EXCHANGE_RATES=true
EXCHANGE_RATE_TIMEOUT_MS=5000

# YouTube ジュエル（縦型ライブ等のギフト）1ジュエルあたりの日本円換算レート（概算）
RATE_JEWEL=1.5

# 特定の通貨だけ手動レートで固定したい場合はコメントを外して指定してください
# （手動指定した通貨は自動取得レートより優先されます）
# RATE_USD=150
# RATE_EUR=163
# RATE_GBP=190
# RATE_TWD=4.7
# RATE_KRW=0.11

# 複数通貨を一括で固定上書きしたい場合は JSON 形式でも指定可能
# 例: EXCHANGE_RATES_JSON={"USD":152.5,"EUR":165}
EXCHANGE_RATES_JSON=
